# Shared with armory and ember_api. Leave empty only for loopback-only use.
INTERNAL_API_TOKEN=
BARD_HOST=127.0.0.1
BARD_PORT=8090
BARD_VOICE=en_US-lessac-medium
BARD_MAX_CHARS=5000
BARD_TTL_HOURS=24
BARD_QUOTA_MB=200
BARD_MAX_CONCURRENT=1
# Bard asks ember_api who holds the bard.admin permission (needed for the voice download tools).
EMBER_API_URL=http://127.0.0.1:8030
# Optional break-glass admins, comma-separated usernames. Leave empty normally.
BARD_ADMINS=
